VITE_USE_MOCK=true
VITE_API_URL=http://localhost:3000
# Optional. Empty = Stadia Alidade Smooth Dark (works on localhost without a key). For a deployed site register the
# domain on Stadia, or put a tile URL with your own key here (keep the key in .env, never in the repo).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
