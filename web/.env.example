VITE_USE_MOCK=true
VITE_API_URL=http://localhost:3000
# Optional. Empty = Stadia Alidade Smooth, light (works on localhost without a key; CARTO tiles now need a key). For a deployed site register the
# domain on Stadia, or put a tile URL with your own key here (keep the key in .env, never in the repo).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# Optional. Google Geocoding key for reverse-geocoding a report that has no saved alamat_teks (Detail Laporan) and for filling the
# address from a map click in the report form. Empty = no lookups, the coordinates are shown instead. Restrict the key to this
# site (HTTP referrer) and to the Geocoding API; keep it in .env, never in the repo.
VITE_GOOGLE_GEOCODING_KEY=
